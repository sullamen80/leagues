rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        userDoc().data.isAdmin == true || userDoc().data.admin == true
      );
    }

    function isChangingAdminFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'isAdmin',
        'admin'
      ]);
    }

    function leagueDoc(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId));
    }

    function isLeagueOwner(leagueId) {
      return isSignedIn() && leagueDoc(leagueId).data.ownerId == request.auth.uid;
    }

    function isLeagueMember(leagueId) {
      return isSignedIn()
        && leagueDoc(leagueId).data.members != null
        && request.auth.uid in leagueDoc(leagueId).data.members;
    }

    function canMemberWriteUserData(leagueId) {
      let league = leagueDoc(leagueId).data;
      return league.gameTypeId != 'wimbledon'
        || !exists(/databases/$(database)/documents/leagues/$(leagueId)/locks/lockStatus)
        || !get(/databases/$(database)/documents/leagues/$(leagueId)/locks/lockStatus).data.keys().hasAny(['entry'])
        || get(/databases/$(database)/documents/leagues/$(leagueId)/locks/lockStatus).data.entry.locked != true;
    }

    function isOwnedLeagueStatsWrite() {
      return isSignedIn()
        && request.resource.data._metadata != null
        && request.resource.data._metadata.sourceLeagueId != null
        && isLeagueOwner(request.resource.data._metadata.sourceLeagueId);
    }

    function isOwnerOrAdmin(leagueId) {
      return isLeagueOwner(leagueId) || isAdmin();
    }

    function memberDraftContextMatches(leagueId, game) {
      let context = game.draft.memberAccess.context;
      let league = leagueDoc(leagueId).data;
      return game.draft.memberAccess.version == 1
        && context.ownerId == league.ownerId
        && context.members == league.get('members', [])
        && context.order == game.draft.get('order', [])
        && context.rosterSize == game.get('rosterSettings', {}).get('rosterSize', 3)
        && context.assignmentMode == game.draft.get('assignmentMode', null)
        && context.useSnakeDraft == game.draft.get('useSnakeDraft', true)
        && context.doubleSnakeConfig == game.draft.get('doubleSnakeConfig', null)
        && context.poolAllocations == game.draft.get('poolAllocations', null)
        && context.teams == game.teamPool.teams;
    }

    function memberPickConsumesSlot(before, after, pick) {
      let access = before.memberAccess;
      let next = after.memberAccess;
      let key = pick.poolId == null ? 'single' : pick.poolId;
      let queue = access.queues[key];
      let slot = queue.turns[access.positions[key]];
      return pick.managerId == request.auth.uid && pick.actorId == request.auth.uid
        && pick.managerId == slot.managerId
        && pick.round == slot.round && pick.orderIndex == slot.orderIndex
        && pick.poolId == slot.poolId && pick.poolLabel == slot.poolLabel
        && pick.get('poolPickNumber', null) == slot.get('poolPickNumber', null)
        && pick.teamId in queue.teamIds && !(pick.teamId in access.takenTeamIds)
        && access.takenTeamIds.size() == before.picks.size()
        && next.diff(access).affectedKeys().hasOnly(['positions', 'takenTeamIds', 'remaining'])
        && next.positions.diff(access.positions).affectedKeys().hasOnly([key])
        && next.positions[key] == access.positions[key] + 1
        && next.takenTeamIds == access.takenTeamIds.concat([pick.teamId])
        && access.remaining > 0 && next.remaining == access.remaining - 1;
    }

    function memberRosterAppendMatches(leagueId, game, pick) {
      let path = /databases/$(database)/documents/leagues/$(leagueId)/userData/$(request.auth.uid);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      let teams = before.get('teams', []);
      let added = after.teams[teams.size()];
      let expected = game.draft.memberAccess.rosterTeams[pick.teamId];
      return teams.size() < game.draft.memberAccess.context.rosterSize
        && after.diff(before).affectedKeys().hasOnly(['teams', 'totalWins', 'updatedAt'])
        && after.teams == teams.concat([added])
        && added.keys().hasAll(expected.keys())
        && added.diff(expected).affectedKeys().hasOnly(['draftPickNumber'])
        && added.draftPickNumber == pick.pickNumber
        && after.totalWins == before.get('totalWins', 0) + added.wins
        && after.updatedAt == request.time;
    }

    function isMemberDraftPick(leagueId, before, after) {
      let oldDraft = before.draft;
      let newDraft = after.draft;
      let pick = newDraft.picks[oldDraft.picks.size()];
      return isLeagueMember(leagueId) && leagueDoc(leagueId).data.gameTypeId == 'winsPool'
        && oldDraft.status == 'in_progress'
        && memberDraftContextMatches(leagueId, before)
        && after.diff(before).affectedKeys().hasOnly(['draft'])
        && newDraft.diff(oldDraft).affectedKeys().hasOnly(['picks', 'memberAccess', 'updatedAt', 'status', 'completedAt'])
        && newDraft.picks == oldDraft.picks.concat([pick])
        && pick.pickNumber == oldDraft.picks.size() + 1
        && pick.source == 'draft-room' && pick.timestamp is timestamp
        && memberPickConsumesSlot(oldDraft, newDraft, pick)
        && newDraft.updatedAt == request.time
        && newDraft.status == (oldDraft.memberAccess.remaining == 1 ? 'completed' : 'in_progress')
        && newDraft.get('completedAt', null) == (oldDraft.memberAccess.remaining == 1 ? request.time : oldDraft.get('completedAt', null))
        && memberRosterAppendMatches(leagueId, before, pick);
    }

    function memberWinsPoolRosterWrite(leagueId, before) {
      let gamePath = /databases/$(database)/documents/leagues/$(leagueId)/gameData/current;
      return leagueDoc(leagueId).data.gameTypeId != 'winsPool'
        || (request.resource.data.get('teams', []) == before.get('teams', [])
          && request.resource.data.get('totalWins', 0) == before.get('totalWins', 0))
        || isMemberDraftPick(leagueId, get(gamePath).data, getAfter(gamePath).data);
    }

    function isLeagueJoinMembershipUpdate() {
      return isSignedIn()
        && request.resource.data.members != null
        && resource.data.members != null
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'members',
          'users',
          'updatedAt'
        ])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }

    function hasValidJoinRequest(leagueId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/joinRequests/$(request.auth.uid))
        && get(/databases/$(database)/documents/leagues/$(leagueId)/joinRequests/$(request.auth.uid)).data.userId == request.auth.uid;
    }

    function isPublicLeagueJoinRequest() {
      return resource.data.private != true
        && resource.data.passwordProtected != true
        && isLeagueJoinMembershipUpdate();
    }

    function isPasswordProtectedLeagueJoinRequest(leagueId) {
      return resource.data.private != true
        && resource.data.passwordProtected == true
        && isLeagueJoinMembershipUpdate()
        && hasValidJoinRequest(leagueId);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['isAdmin', 'admin']);
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && !isChangingAdminFields())
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /teamPools/{poolId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /gameStats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /{subcollection}/{subDocId} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isOwnedLeagueStatsWrite();
      }
    }

    match /statsHistory/{leagueKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /leagueSecrets/{leagueId} {
      allow read, write: if isOwnerOrAdmin(leagueId);
    }

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOrAdmin(leagueId)
        && (request.resource.data.ownerId == resource.data.ownerId || isAdmin())
        || isPublicLeagueJoinRequest()
        || isPasswordProtectedLeagueJoinRequest(leagueId);
      allow delete: if isOwnerOrAdmin(leagueId);

      match /joinRequests/{userId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isOwnerOrAdmin(leagueId);
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && !isLeagueMember(leagueId)
          && leagueDoc(leagueId).data.passwordProtected == true
          && request.resource.data.keys().hasOnly([
            'userId',
            'passwordHash',
            'createdAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.passwordHash is string
          && exists(/databases/$(database)/documents/leagueSecrets/$(leagueId))
          && get(/databases/$(database)/documents/leagueSecrets/$(leagueId)).data.passwordHash == request.resource.data.passwordHash;
        allow update: if false;
        allow delete: if (isSignedIn() && request.auth.uid == userId) || isOwnerOrAdmin(leagueId);
      }

      match /userData/{userId} {
        allow read: if isLeagueMember(leagueId) || isOwnerOrAdmin(leagueId);
        allow create: if isOwnerOrAdmin(leagueId)
          || (isSignedIn() && request.auth.uid == userId && isLeagueMember(leagueId)
            && canMemberWriteUserData(leagueId) && memberWinsPoolRosterWrite(leagueId, {}));
        allow update: if isOwnerOrAdmin(leagueId)
          || (isSignedIn() && request.auth.uid == userId && isLeagueMember(leagueId)
            && canMemberWriteUserData(leagueId) && memberWinsPoolRosterWrite(leagueId, resource.data));
        allow delete: if isOwnerOrAdmin(leagueId);
      }

      match /auditLog/{auditId} {
        allow read: if isLeagueMember(leagueId) || isOwnerOrAdmin(leagueId);
        allow create: if isOwnerOrAdmin(leagueId);
        allow update, delete: if false;
      }

      match /gameData/current {
        allow update: if isMemberDraftPick(leagueId, resource.data, request.resource.data);
      }

      match /{subcollection}/{docId} {
        allow read: if isLeagueMember(leagueId) || isOwnerOrAdmin(leagueId);
        allow write: if subcollection != 'auditLog' && isOwnerOrAdmin(leagueId);
      }
    }
  }
}
